[init]
	defaultBranch = main
[user]
	name = pinpinroku
	email = pinpinroku11600@tutanota.com
[core]
    pager = bat --plain --color=always
[pager]
    diff = delta
    show = delta
	log = bat --plain --color=always
[commit]
	template = ~/.gitmessage
[fetch]
	prune = true
[pull]
	rebase = false
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true    # use n and N to move between diff sections
	dark = true
	side-by-side = true
	line-numbers = true
[diff]
	colorMoved = default
[merge]
	conflictstyle = zdiff3
[push]
	autoSetupRemote = true
[credential]
	helper = cache --timeout=3600
	helper = /usr/lib/git-core/git-credential-libsecret
